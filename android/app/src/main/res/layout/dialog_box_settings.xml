<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <!-- 风扇转速 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="风扇转速"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/fanSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="4"
        android:progress="0" />

    <TextView
        android:id="@+id/fanValueLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="当前：停"
        android:textColor="@color/sub"
        android:textSize="12sp" />

    <!-- 蜂鸣器开关（音量固定，只开关） -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/buzzSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:checked="true"
        android:text="蜂鸣器提示音（音量固定，仅开关）"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <!-- 测试提示音 -->
    <Button
        android:id="@+id/beepBtn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_primary"
        android:stateListAnimator="@null"
        android:text="测试蜂鸣一下（盒子会响）"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="提示：风扇分 0/20/50/70/100% 五档调速，蜂鸣器仅开关；点&quot;应用&quot;即实时下发到盒子；换房间码请先在盒子配网页或重新配网修改。"
        android:textColor="@color/sub"
        android:textSize="11sp" />

</LinearLayout>
